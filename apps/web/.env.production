# Live data — published Google Sheets CSV URLs (production build / GitHub Pages deploy).
# Loaded by `yarn build`. NOT loaded in `test` mode, so the test suite keeps using the
# bundled seed CSVs in public/data/. These VITE_* values are public (inlined into the
# client bundle) — they are not secrets. To revert a sheet to its bundled copy, blank its line.
# See .claude/google-sheets/README.md and apps/web/src/shared/config/sheets.ts.

VITE_SHEETS_STORIES_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQGXjzwz1mAMCS9_84EkpWDZq0rNmW_Faio1PWVEG586ebwDSywWbNGhzc7doaY8OSVlt4Dk9tRh2pg/pub?gid=612920737&single=true&output=csv
